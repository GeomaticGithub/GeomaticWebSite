# Contact form (src/app/api/contact/route.ts)
# Copy this file to .env.local, fill it in, then restart the server.
# Check the settings with:  npm run mail:check   (and  npm run mail:send-test  to send one test message per mailbox)

# --- Mail server used to send the messages of the contact form ---
# Ask your e-mail provider for the "SMTP" settings. Common values:
#   Microsoft 365 : smtp.office365.com, port 587
#   Google Workspace : smtp.gmail.com, port 587 (with an "app password")
#   Hosting provider (cPanel, OVH…) : often mail.<your domain>, port 465 or 587
SMTP_HOST=
# 587 (STARTTLS) or 465 (SSL)
SMTP_PORT=587
# Leave empty to choose automatically (true when the port is 465)
SMTP_SECURE=
# On port 587 the site refuses to log in or send anything unless the server encrypts the connection.
# Do not add SMTP_REQUIRE_TLS=false here: it exists for a local test server only.

# Only when "npm run mail:check" reports that the certificate is issued for another name
# (inwi presents a certificate for *.inwi.ma): the name to check the certificate against, for example smtp.inwi.ma
SMTP_TLS_SERVERNAME=
# The mailbox the site logs in with, and its password.
# Security: use a mailbox created for the site only (for example site@geomatic.ma), not contact@, sales@ or support@.
# If its password leaks, nobody's mail can be read and you only have to change that one password.
# On the production server, set SMTP_USER and SMTP_PASS in the hosting panel ("environment variables") rather than in a file.
SMTP_USER=site@geomatic.ma
SMTP_PASS=

# --- Sender ---
# Address shown as the sender. It must be one the mail server lets SMTP_USER send from (default: SMTP_USER).
CONTACT_FROM=

# --- Mailboxes that receive the messages, by subject of the form ---
# General mailbox: "Other request", and every subject that has no mailbox of its own
CONTACT_TO=contact@geomatic.ma
# "Sales and licenses"
CONTACT_TO_SALES=sales@geomatic.ma
# "Support and customer service"
CONTACT_TO_SUPPORT=support@geomatic.ma
# "Training" and "Consulting": empty = general mailbox. Set an address to send them elsewhere (for example sales@geomatic.ma).
CONTACT_TO_TRAINING=training@geomatic.ma
CONTACT_TO_CONSULTING=consulting@geomatic.ma
